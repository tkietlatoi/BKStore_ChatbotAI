{
  "name": "bkstore-chatbot-ai",
  "version": "1.0.0",
  "description": "BK-Store: Website Thương Mại Điện Tử Thiết Bị Công Nghệ Tích Hợp AI Chatbot",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ecommerce",
    "ai-chatbot",
    "langchain",
    "gemini",
    "nextjs",
    "express",
    "postgresql",
    "pgvector"
  ],
  "author": "BK-Store Team",
  "license": "ISC"
}
